# Live platform checks: copy to .env.live (git-ignored), fill in what you have,
# and run ./scripts/live_test.sh. Platforms without credentials are skipped.
#
# Tokens: the easiest source is a channel you already connected in OmniPost.
#   docker compose exec api python manage.py shell -c \
#     "from omnipost_api.models import Channel; print(Channel.objects.get(pk=<id>).get_credentials())"
# Post ids: the remote_id of a published target (Posts -> Delivery), or the
# id from the post's URL on the platform.

# Set to 1 to also publish a real "OmniPost live test" post on each platform,
# and to 1 to reply to it with a first comment.
LIVE_PUBLISH=0
LIVE_FIRST_COMMENT=0

LIVE_X_ACCESS_TOKEN=
LIVE_X_POST_ID=
# Optional, for the refresh test:
LIVE_X_REFRESH_TOKEN=
LIVE_X_CLIENT_ID=
LIVE_X_CLIENT_SECRET=

LIVE_LINKEDIN_ACCESS_TOKEN=
LIVE_LINKEDIN_MEMBER_URN=          # urn:li:person:...
LIVE_LINKEDIN_POST_URN=            # urn:li:share:... or urn:li:ugcPost:...

LIVE_FACEBOOK_PAGE_ID=
LIVE_FACEBOOK_PAGE_ACCESS_TOKEN=
LIVE_FACEBOOK_POST_ID=             # <page id>_<post id>

LIVE_INSTAGRAM_IG_USER_ID=
LIVE_INSTAGRAM_PAGE_ACCESS_TOKEN=
LIVE_INSTAGRAM_MEDIA_ID=

LIVE_THREADS_USER_ID=
LIVE_THREADS_ACCESS_TOKEN=
LIVE_THREADS_POST_ID=
LIVE_THREADS_REFRESH_TOKEN=

LIVE_YOUTUBE_ACCESS_TOKEN=
LIVE_YOUTUBE_VIDEO_ID=
LIVE_YOUTUBE_REFRESH_TOKEN=
# Needed for YouTube/TikTok refresh (the deployment's own app):
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LIVE_TIKTOK_ACCESS_TOKEN=
LIVE_TIKTOK_REFRESH_TOKEN=

LIVE_BLUESKY_IDENTIFIER=
LIVE_BLUESKY_APP_PASSWORD=
LIVE_BLUESKY_POST_URI=             # at://did:plc:.../app.bsky.feed.post/...

LIVE_MASTODON_INSTANCE_DOMAIN=
LIVE_MASTODON_ACCESS_TOKEN=
LIVE_MASTODON_STATUS_ID=

LIVE_DISCORD_WEBHOOK_URL=
LIVE_TELEGRAM_BOT_TOKEN=
LIVE_TELEGRAM_CHAT_ID=
